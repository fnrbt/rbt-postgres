<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Rbt.Postgres</RootNamespace>
    <AssemblyName>Rbt.Postgres</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningLevel>3</WarningLevel>
    <IsPackable>true</IsPackable>
    <PackageId>Rbt.Postgres</PackageId>
    <Description>RedBat PostgreSQL client - the frontend/backend wire protocol (v3.0) in F#: TLS, SCRAM-SHA-256, simple and extended query, typed decoding, streaming, COPY, cancellation, LISTEN/NOTIFY and replication</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Wire.fs" />
    <Compile Include="Messages.fs" />
    <Compile Include="Errors.fs" />
    <Compile Include="Tls.fs" />
    <Compile Include="Scram.fs" />
    <Compile Include="Oids.fs" />
    <Compile Include="Codecs.fs" />
    <Compile Include="Connection.fs" />
    <Compile Include="Replication.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="FSharp.Core" Version="10.1.302" />
  </ItemGroup>

</Project>
